<?xml version="1.0"?>
<sdf version="1.8">
  <world name="default">
    <!--
      Forked from turtlebot3_gazebo/worlds/turtlebot3_world.world.

      Physics relaxed 1000 Hz -> 250 Hz. Measured on this machine: the gz server sat at
      ~248% CPU (~2.5 of 20 cores) while only reaching RTF 0.54, i.e. it was not starved
      for cores but limited by a saturated single thread. At 1000 steps/s, ~1.85 ms of
      work per step caps RTF near 0.54 -- which is what we saw. 4x fewer steps lifts that
      ceiling, and cuts /clock traffic 4x as a bonus.

      Keep real_time_update_rate * max_step_size == 1.0, or the target rate changes too.
      No sensor update_rate may exceed 1/max_step_size = 250 Hz; the IMU at 200 Hz fits.
    -->
    <physics type="ode">
      <real_time_update_rate>250.0</real_time_update_rate>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <!-- Shadow mapping is expensive in ogre2 and contributes nothing to lidar or to
         the RGB/depth images the perception pipeline consumes. -->
    <scene>
      <shadows>false</shadows>
    </scene>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <model name="turtlebot3_world">
      <static>1</static>
      <include>
        <uri>model://turtlebot3_world</uri>
      </include>
    </model>
  </world>
</sdf>
